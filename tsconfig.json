{
    "compilerOptions": {
        "target": "ES2020",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "isolatedModules": true,
        "lib": [
            "ES2020",
            "DOM"
        ],
        "types": [
            "@types/chrome",
            "vite/client"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        // "outDir": "./dist",
        "sourceMap": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
